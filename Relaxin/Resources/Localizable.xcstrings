    "The background execution assertion expired before the engine returned.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية تصريح التنفيذ في الخلفية قبل أن يُكمل المحرك عمله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freigabe zur Hintergrundausführung ist abgelaufen, bevor das Modul fertig war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The background execution assertion expired before the engine returned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de ejecución en segundo plano ha caducado antes de que el motor terminara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation d’exécution en arrière-plan a expiré avant la fin de l’exécution du moteur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンが完了する前に、バックグラウンド実行アサーションの有効期限が切れました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия разрешения на фоновое выполнение истёк до завершения работы модуля."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền duy trì tác vụ chạy trong nền đã hết hạn trước khi mô-đun hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台执行断言在引擎返回前已过期。"
          }
        }
      }
    },
    "The device CPU family could not be read.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت قراءة عائلة وحدة المعالجة المركزية للجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die CPU-Familie des Geräts konnte nicht ausgelesen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device CPU family could not be read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer la familia de CPU del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la famille de processeurs de l’appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのCPUファミリを読み取れませんでした。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить семейство процессора устройства."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc dòng CPU của thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取设备 CPU 系列。"
          }
        }
      }
    },
    "The engine could not remain active in the background.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إبقاء المحرك نشطًا في الخلفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modul konnte im Hintergrund nicht aktiv bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine could not remain active in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor no ha podido permanecer activo en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur n’a pas pu rester actif en arrière-plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンをバックグラウンドで動作させ続けることができませんでした。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модулю не удалось продолжить работу в фоновом режиме."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô-đun không thể tiếp tục hoạt động trong nền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎无法在后台保持活动。"
          }
        }
      }
    },
    "The exact device identifier could not be read.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
