{
  "sourceLanguage": "en",
  "strings": {
    "A problem has been detected and RELAXIN-X stopped the setup engine.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اكتشاف مشكلة، وأوقف RELAXIN-X محرك الإعداد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde ein Problem erkannt und RELAXIN-X hat das Einrichtungsmodul angehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A problem has been detected and RELAXIN-X stopped the setup engine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha detectado un problema y RELAXIN-X ha detenido el motor de configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème a été détecté et RELAXIN-X a arrêté le moteur de configuration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が検出されたため、RELAXIN-Xはセットアップエンジンを停止しました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружена проблема, и RELAXIN-X остановил модуль настройки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã phát hiện sự cố và RELAXIN-X đã dừng mô-đun thiết lập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到问题，RELAXIN-X 已停止安装引擎。"
          }
        }
      }
    },
    "A userspace reboot is necessary to apply the changes. Do you want to do it now?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة تشغيل Userspace ضرورية لتطبيق التغييرات. هل تريد فعلها الآن؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Anwenden der Änderungen ist ein Userspace-Neustart erforderlich. Möchtest du das jetzt durchführen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A userspace reboot is necessary to apply the changes. Do you want to do it now?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es necesario reiniciar el Espacio de Usuario para aplicar los cambios. ¿Quieres reiniciarlo ahora?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un redémarrage de l’espace utilisateur est nécessaire pour appliquer les modifications. Voulez-vous le faire maintenant ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を適用するにはuserspaceの再起動が必要です。今すぐ再起動しますか？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для применения изменений необходимо перезагрузить Userspace. Перезагрузить сейчас?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần khởi động lại Userspace để áp dụng thay đổi. Bạn có muốn thực hiện ngay không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重启用户空间才能应用更改，是否现在重启？"
          }
        }
      }
    },
