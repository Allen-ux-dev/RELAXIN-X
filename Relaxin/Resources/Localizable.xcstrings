    "iOS %@ does not have a supported runtime profile.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتوفر ملف تعريف وقت تشغيل مدعوم لنظام iOS %1$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für iOS %1$@ ist kein unterstütztes Laufzeitprofil verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS %1$@ does not have a supported runtime profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS %1$@ no dispone de un perfil de ejecución compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS %1$@ ne dispose d’aucun profil d’exécution pris en charge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS %1$@に対応するランタイムプロファイルがありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для iOS %1$@ нет поддерживаемого профиля среды выполнения."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS %1$@ không có cấu hình runtime được hỗ trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS %1$@ 没有受支持的运行时配置文件。"
          }
        }
      }
    },
    "iOS did not grant the required background execution assertion.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يمنح iOS تصريح التنفيذ المطلوب في الخلفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS hat die erforderliche Freigabe zur Hintergrundausführung nicht erteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS did not grant the required background execution assertion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no ha concedido el permiso necesario para la ejecución en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS n’a pas accordé l’autorisation requise pour l’exécution en arrière-plan."
