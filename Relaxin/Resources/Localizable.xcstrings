          "stringUnit": {
            "state": "translated",
            "value": "Jailbreakの対象は実機のiPhoneまたはiPadである必要があります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Целью джейлбрейка должен быть физический iPhone или iPad."
