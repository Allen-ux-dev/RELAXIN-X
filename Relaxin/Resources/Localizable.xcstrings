    "Backend preferences never bypass compatibility checks. Recommended selects the best eligible stable backend automatically.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتجاوز تفضيلات الواجهة الخلفية فحوصات التوافق أبداً. يختار الخيار الموصى به أفضل واجهة مستقرة مؤهلة تلقائياً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backend-Einstellungen umgehen niemals Kompatibilitätsprüfungen. „Empfohlen“ wählt automatisch das beste geeignete stabile Backend."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backend preferences never bypass compatibility checks. Recommended selects the best eligible stable backend automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las preferencias de backend nunca omiten las comprobaciones de compatibilidad. Recomendado selecciona automáticamente el mejor backend estable apto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les préférences de backend ne contournent jamais les vérifications de compatibilité. Recommandé sélectionne automatiquement le meilleur backend stable admissible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックエンド設定が互換性チェックを回避することはありません。「推奨」は利用可能な最適の安定版バックエンドを自動選択します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпочтения бэкенда никогда не обходят проверки совместимости. «Рекомендуется» автоматически выбирает лучший подходящий стабильный бэкенд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn backend không bao giờ bỏ qua kiểm tra tương thích. Khuyên dùng sẽ tự động chọn backend ổn định phù hợp tốt nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后端偏好永远不会绕过兼容性检查。“推荐”会自动选择最合适的稳定后端。"
          }
        }
      }
    },
