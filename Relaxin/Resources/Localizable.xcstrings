        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSから必要なバックグラウンド実行アサーションを取得できませんでした。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система iOS не предоставила необходимое разрешение на фоновое выполнение."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
